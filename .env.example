# انسخ هذا الملف إلى .env.local محليًا، وأضف نفس القيم في Vercel → Settings → Environment Variables
# لا تضع القيم الحقيقية في هذا الملف أبدًا (هذا الملف يُرفع إلى Git)

# قاعدة بيانات Turso (إلزاميان)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# عنوان خدمة دمج الفيديو (مشروع merger المنشور على Vercel) — إلزامي لأداة merge_videos
MERGER_API_BASE=https://<merger-project>.vercel.app

# اختياري: حماية مسار /mcp بمفتاح Bearer (إن ضُبط يُطلب Authorization: Bearer <token>)
MCP_ACCESS_TOKEN=

# اختياري: تجاوز أسماء الموديلات لدى المزودين إن تغيّرت لديهم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
